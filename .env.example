# Rename this file to ".env" for use

# API BASE URL
# PRODUCTION: Https://api.publicsquare.com
# TEST:  https://staging.api.publicsquare.com
NEXT_PUBLIC_PUBLICSQUARE_API_URI=https://api.publicsquare.com

# Public key
NEXT_PUBLIC_PUBLICSQUARE_API_KEY=pk_test_your_publishable_key

# Secret key
PUBLICSQUARE_API_SECRET=sk_test_your_secret_key

# Comma-separated list of extra origins allowed to access the dev server (optional).
# Falls back to a built-in default in next.config.mjs if unset.
ALLOWED_DEV_ORIGINS=applepay.publicsquare.com

